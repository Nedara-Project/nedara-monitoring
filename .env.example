# Optional tuning of the Docker demo stack (docker compose up).
# Every variable below already has a default: copying this file is not needed.
#
# The demo credentials (SSH and PostgreSQL) are deliberately not configurable
# here: they must match docker/config.ini.demo, which is what the application
# reads, so they live in that file and in docker-compose.yml.

# Ports published on the host. The demo web server stays on 8080: it is the
# port external_url points to in docker/config.ini.demo.
APP_PORT=5000
MAILDEV_PORT=1080

# Runtime user of the application container. It must own ./config.ini for the
# admin interface to save it — set it to your own uid if it is not 1000, or to 0
# under rootless Docker, which maps the host owner to uid 0 in the container.
APP_UID=1000
APP_GID=1000

# pgbench load generator. Kept small on purpose — the demo database lives in a
# tmpfs, and a handful of clients is enough to move the charts.
PGBENCH_SCALE=10
PGBENCH_CLIENTS=4
PGBENCH_DURATION_S=3600

; Nedara Monitoring — example configuration file.
; Copy this file to config.ini and adapt it to your infrastructure.
;
; The configuration is modular. The [general] and [environments] sections are mandatory.
; Environment and server section names are free — use whatever names make sense to you.
; Server types supported: linux, postgres, pgbouncer.
; Important: make sure the SSH user has read access to all files referenced below.

; ──────────────────────────────────────────────────────────────
; GENERAL
; ──────────────────────────────────────────────────────────────
[general]
port = 5000
display_name =
refresh_rate = 1
chart_history = 5000
chart_adaptive_display = 1
debug = 0
secret_key = your-secret-app-key

; ── Admin interface (/admin) ──
; Set admin_enabled=1 to enable the web-based configuration interface at /admin.
; On first access, you will be prompted to set a password directly in the browser.
;
; To set the password hash manually instead:
;   python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('yourpassword'))"
; Then paste the output below.
;
; Set admin_enabled=0 (or leave it unset) to disable /admin entirely (returns 403).
admin_enabled = 0
admin_password =

; ── Email notifications ──
; Leave all fields empty to disable email alerts.
; login/password may be left empty for a relay that requires no authentication.
; STARTTLS is used when the SMTP server advertises it.
email_notif_smtp_server =
email_notif_smtp_port =
email_notif_login =
email_notif_password =
email_notif_recipients = recipient1@mail.com, recipient2@mail.com

; ── Alert behaviour (defaults for every environment) ──
; Each of these keys can be repeated in an environment section to override it there.
;
; alert_email_min_severity: lowest severity that triggers an email: critical (default)
;   or warning. Warnings always appear on the dashboard either way.
; alert_repeat_minutes: delay before the same, still-active alert is emailed again.
; alert_resolved_emails: 1 (default) to also email when an alert clears.
; alert_sustain_seconds: an issue must hold this long before it is raised. Filters
;   out single-sample spikes (a CPU peak between two polls).
; alert_clear_seconds: a raised alert stays visible (marked "clearing") this long
;   after the condition disappears, so nothing flaps in and out of the list.
alert_email_min_severity = critical
alert_repeat_minutes = 60
alert_resolved_emails = 1
alert_sustain_seconds = 5
alert_clear_seconds = 15

; ──────────────────────────────────────────────────────────────
; ALERT THRESHOLDS
; ──────────────────────────────────────────────────────────────
; Every key below is optional — the value shown is the built-in default.
; A metric reaching its *_warning value raises a warning, its *_critical value a
; critical alert. Thresholds resolve from the most specific scope to the least:
;   server section  >  environment section  >  [thresholds]  >  built-in default
; So `cpu_critical = 95` inside [serv1] only affects that server.
[thresholds]
; Linux servers — CPU, RAM and root filesystem, in %
cpu_warning = 70
cpu_critical = 90
ram_warning = 70
ram_critical = 90
disk_warning = 70
disk_critical = 90
; Any mounted volume other than / (in %)
mount_warning = 70
mount_critical = 90
; Load average (1m) divided by the CPU core count
load_warning = 1.5
load_critical = 3.0
; Web application response time (ms)
response_time_warning = 1000
response_time_critical = 5000
; PostgreSQL — longest running active query (s)
pg_active_wait_warning = 30
pg_active_wait_critical = 120
; PostgreSQL — longest "idle in transaction" (s)
pg_idle_tx_warning = 120
pg_idle_tx_critical = 600
; PGBouncer — waiting client connections (count)
pgb_waiting_warning = 1
pgb_waiting_critical = 5
; PGBouncer — longest client wait for a server connection (s)
pgb_maxwait_warning = 1
pgb_maxwait_critical = 5

; ──────────────────────────────────────────────────────────────
; ENVIRONMENTS
; ──────────────────────────────────────────────────────────────
[environments]
available_env = env1, env2
default_env = env2

; ──────────────────────────────────────────────────────────────
; ENVIRONMENT SECTIONS
; ──────────────────────────────────────────────────────────────
[env1]
url = https://your-url1
; external_url: optional — URL used for the dashboard link when it differs from
; the URL probed above (e.g. internal address for the check, public one for the
; browser). Defaults to url.
external_url =
url_name =
servers = serv1, serv2, serv3, pgb1
; send_emails: set to 0 to disable all email alerts for this environment (e.g. staging).
send_emails = 1
; alert_delay_minutes: wait this many minutes before sending an alert.
; Prevents notifications for brief/transient outages. 0 = send immediately.
alert_delay_minutes = 0
; Any [general] alert key and any [thresholds] key can be repeated here to
; override it for this environment only, for example:
;   alert_email_min_severity = warning
;   cpu_critical = 95

[env2]
url = https://your-url2
url_name =
servers = serv4, serv5, serv6
send_emails = 1
alert_delay_minutes = 0

; ──────────────────────────────────────────────────────────────
; SERVER SECTIONS
; ──────────────────────────────────────────────────────────────

; Linux server (SSH)
[serv1]
type = linux
name =
host =
; port: optional — SSH port (default: 22)
port = 22
user =
password =
; log_file: optional — path to a log file to tail (displayed via the "Logs" button)
log_file =
; nginx_access_file: optional — enables the HTTP Requests chart
nginx_access_file =
; show_mounts: set to 0 to hide the mounted volumes section (partitions other than /).
; Default is 1 (visible). Excluded from collection: tmpfs, devtmpfs, squashfs.
show_mounts = 1
chart_label =
chart_color = #3b82f6
; Any [thresholds] key can be repeated here to override it for this server only,
; e.g. a build machine that is expected to run hot:
;   cpu_warning = 90
;   cpu_critical = 98

[serv2]
type = linux
name =
host =
user =
password =
show_mounts = 1
chart_label =
chart_color = #10b981

; PostgreSQL database
[serv3]
type = postgres
name =
host =
port =
user =
password =
database =

; PGBouncer connection pooler (optional)
; Connects to the pgbouncer admin database using the PostgreSQL protocol.
; The user must be listed in admin_users in pgbouncer.ini and have access to
; run SHOW POOLS; SHOW STATS; SHOW CONFIG; on the pgbouncer admin interface.
[pgb1]
type = pgbouncer
name = PGBouncer
host =
port = 6432
database = pgbouncer
user =
password =

[serv4]
type = linux
name =
host =
user =
password =
log_file =
nginx_access_file =
chart_label =
chart_color = #3b82f6

[serv5]
type = linux
name =
host =
user =
password =
chart_label =
chart_color = #10b981

[serv6]
type = postgres
name =
host =
port =
user =
password =
database =

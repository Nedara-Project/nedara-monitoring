[demo-env]
# tested by the monitoring app
url = http://demo-server2/
# reachable from the end-user browser (default to 'url')
external_url = http://localhost/
url_name = "Demo Webserver"
servers = demo-server1, demo-db1
send_emails = 1
alert_delay_minutes = 0

[demo-server1]
